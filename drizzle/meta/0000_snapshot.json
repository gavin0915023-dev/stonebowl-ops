          "value": "\"orders\".\"channel\" IN ('demo', 'manual', 'meituan-import')"
        },
        "orders_demo_channel_isolated": {
          "name": "orders_demo_channel_isolated",
          "value": "\"orders\".\"channel\" != 'demo' OR \"orders\".\"is_demo\" = 1"
        },
        "orders_valid_status": {
          "name": "orders_valid_status",
          "value": "\"orders\".\"status\" IN ('new', 'preparing', 'ready', 'handed_over', 'cancelled')"
        },
        "orders_positive_version": {
          "name": "orders_positive_version",
          "value": "\"orders\".\"version\" >= 1"
        },
        "orders_nonnegative_amount": {
          "name": "orders_nonnegative_amount",
          "value": "\"orders\".\"amount_cents\" >= 0 AND \"orders\".\"amount_cents\" <= 100000000 AND typeof(\"orders\".\"amount_cents\") = 'integer'"
        },
        "orders_valid_document": {
          "name": "orders_valid_document",
          "value": "json_valid(\"orders\".\"document\")"
